# =============================================================================
# Virtual Gravity AI Sales Engine — Environment Variables
# Copy this file to .env.local and fill in the values for local development.
# NEVER commit .env.local or any file with real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — PUBLIC (safe to expose to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Supabase — SECRET (SERVER ONLY — never expose to the client)
# Used only in server-side code for admin operations (e.g. invite flows,
# background processing). The service-role key bypasses RLS.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AI / LLM (Phase 4) — SERVER ONLY
# Production and Vercel preview FAIL CLOSED unless OpenAI is configured.
# Local/tests: AI_PROVIDER=mock, or unset with no OPENAI_API_KEY, uses mock.
# Explicit AI_PROVIDER=mock is never a silent fallback in production.
# Never expose these values to the browser.
# -----------------------------------------------------------------------------
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=15000
# AI_MAX_OUTPUT_TOKENS=400

# -----------------------------------------------------------------------------
# Internal drain wake-up — SERVER ONLY
# Drain routes require Authorization: Bearer <CRON_SECRET>:
#   GET/POST /api/v1/internal/ai-jobs/drain  (AI jobs + channel deliveries)
#   GET/POST /api/v1/internal/channel-deliveries/drain
# Vercel Hobby cron is once-daily only; sub-daily vercel.json crons fail deploy.
# Production: use a free 1-minute HTTP cron against ai-jobs/drain.
# See docs/pilot-drain-scheduler.md. Inbound still processes via after().
# -----------------------------------------------------------------------------
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Public signup — SERVER ONLY
# Pilot default: unset/false disables /sign-up and signUpAction.
# Set ALLOW_PUBLIC_SIGNUP=true only to re-enable self-serve onboarding.
# Login and existing membership are unchanged.
# -----------------------------------------------------------------------------
# ALLOW_PUBLIC_SIGNUP=false

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Phase 5.2B, text-only) — SERVER ONLY
# Per-account credentials (access token, app secret, verify token, phone
# number ID) are stored in channel_account_secrets, never in env.
# Optional Graph API version override. Default: v21.0
# Delivery is at-least-once. WhatsApp does not accept a provider idempotency
# key on the text-send endpoint; a lost 2xx response may duplicate a send.
# -----------------------------------------------------------------------------
# WHATSAPP_GRAPH_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# Email / Resend (Phase 5.3B, text-only) — SERVER ONLY
# Per-account Email credentials (Resend API key + Svix webhook signing secret
# + receiving mailbox) are stored in channel_account_secrets, never in env.
# Do NOT use RESEND_API_KEY as a tenant channel secret. That env var is
# unrelated platform configuration and is unused by the Email channel.
# Delivery is at-least-once. Idempotency-Key = internal messageId.
# Tests use mocked/injected HTTP; there are no live Resend integration tests.
# -----------------------------------------------------------------------------
# RESEND_API_KEY=

# -----------------------------------------------------------------------------
# SMS / Telnyx (Phase 5.4B, text-only) — SERVER ONLY
# Per-account SMS credentials (Telnyx API key + Ed25519 public key + E.164
# destination) are stored in channel_account_secrets, never in env.
# Do NOT use TELNYX_API_KEY as a tenant channel secret. That env var is
# unused by the SMS channel.
# Inbound: Ed25519 over `{timestamp}|{rawBody}` (±300s). Outbound:
# POST https://api.telnyx.com/v2/messages. Official send-message docs do not
# document Idempotency-Key; delivery is at-least-once and a lost 2xx may
# duplicate a send. Tests use mocked/injected HTTP; there are no live Telnyx
# integration tests. MMS/media/receipts/templates/campaigns are out of scope.
# -----------------------------------------------------------------------------
# TELNYX_API_KEY=

# -----------------------------------------------------------------------------
# Telegram Bot API (Phase 5.2, text-only) — SERVER ONLY
# Per-account credentials (bot token + generated webhook secret_token + bot
# username/id destination) are stored in channel_account_secrets, never in env.
# The webhook secret is NOT the bot token. Header:
#   X-Telegram-Bot-Api-Secret-Token
# setWebhook is an explicit owner/admin action (create, rotate, or
# POST .../channel-accounts/:id/telegram-webhook). It is not registered at
# process startup. Delivery is at-least-once; sendMessage has no provider
# idempotency key. Tests use mocked/injected HTTP.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Demo video overlay — PUBLIC
# Temporary Horizon Realty dummy data on every dashboard page.
# Unset or set to true for the product video. Set false to use live CRM data.
# Tests always ignore this flag.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ZEUS_DEMO_DATA=true

# -----------------------------------------------------------------------------
# Future sections (not yet required)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
